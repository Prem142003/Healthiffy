NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/healthiffy
MONGO_DB_NAME=healthiffy

CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=hf_refresh_token
COOKIE_DOMAIN=

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=healthiffy

CASHFREE_ENV=sandbox
CASHFREE_APP_ID=your-cashfree-sandbox-app-id
CASHFREE_SECRET_KEY=your-cashfree-sandbox-secret-key
CASHFREE_API_VERSION=2025-01-01
CASHFREE_WEBHOOK_URL=https://your-public-backend.example/api/v1/payments/webhooks/cashfree
CUSTOMER_PAYMENT_MODE=PAY_AT_COUNTER

ADMIN_NAME=Healthiffy Admin
ADMIN_EMAIL=admin@healthiffy.example
ADMIN_PASSWORD=replace-with-a-strong-password
